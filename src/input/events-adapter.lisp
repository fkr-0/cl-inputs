(uiop:define-package :cl-inputs.events (:use :cl) (:import-from :cl-inputs.tokens #:input-token-kind) (:export #:token->event #:event-bus-sink)) (in-package :cl-inputs.events) (defun token->event (token) "Convert an input TOKEN into a CL-EVENTS event for bus delivery." (cl-events.types:make-event :type (input-token-kind token) :data token)) (defun event-bus-sink (bus &key (topic :input/token)) "Return a sink function that publishes input tokens to BUS under TOPIC." (lambda (token) (cl-events.bus:publish-event bus (cl-events.types:make-event :type topic :data (token->event token)))))
